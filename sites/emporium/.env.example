# 7 days = 7 * 24 * 60 * 60 * 1000
SESSION_LENGTH=604800000
SESSION_NAME=session

# at least 16 characters; use a long random one, e.g. `openssl rand -base64 32`
ENCRYPTION_SECRET=change-me-to-a-long-random-string

# outbound email credentials
MAILERSEND_API_KEY=api-key

# use this as password to log in as dev mode won't send login emails
DEV_PASSPHRASE=karl
