{
  "name": "parlor",
  "description": "a room for games",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 5179",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "levels": "node scripts/check-levels.ts",
    "murals": "node scripts/make-murals.ts",
    "forage:tune": "node scripts/tune-forage.ts",
    "forage:pictures": "node scripts/make-forage-pictures.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@pierogis/utensils": "workspace:*",
    "ui": "workspace:*"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
