---
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import LoafGrid from '../components/LoafGrid.astro';

const allLoafs = await getCollection(
	'loafs',
	({ data }) => import.meta.env.DEV || data.draft !== true
);

const description = 'well beyond the pale';
---

<Base canonical={`https://stale.pierogis.live`} title="stale" description={description}>
	<i>{description}</i>
	<LoafGrid loafs={allLoafs} />
</Base>
