{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stale",
	"compatibility_date": "2025-08-07",
	// The site is fully prerendered, so the Worker serves only static assets.
	"assets": {
		"directory": "./dist"
	},
	"routes": [{ "pattern": "stale.pierogis.live", "custom_domain": true }],
	"observability": {
		"enabled": true
	}
}
