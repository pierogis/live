{
  "name": "pierogis",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm -r --no-sort run check",
    "lint": "prettier --check --cache . && eslint ./",
    "format": "prettier --write --list-different --cache .",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.2"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21",
    "pnpm": ">=12"
  }
}
