{
  "name": "ui",
  "version": "0.0.0",
  "description": "internal components for sites",
  "private": true,
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@pierogis/utensils": "workspace:*"
  },
  "type": "module",
  "svelte": "./components/index.ts",
  "exports": {
    ".": {
      "svelte": "./components/index.ts",
      "default": "./components/index.ts"
    },
    "./*.svelte": {
      "svelte": "./components/*.svelte",
      "default": "./components/*.svelte"
    }
  },
  "peerDependencies": {
    "svelte": "^5"
  }
}
