{
  "name": "@pierogis/utensils",
  "version": "1.0.1",
  "description": "a set of utensils to aid consumption",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierogis/live.git"
  },
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/pierogis/live/issues"
  },
  "homepage": "https://utensils.pierogis.live",
  "keywords": [
    "svelte",
    "ui",
    "components"
  ],
  "type": "module",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./styles/*": "./src/lib/styles/*",
    "./theme": {
      "types": "./src/lib/theme/index.ts",
      "default": "./src/lib/theme/index.ts"
    },
    "./utils/*": {
      "types": "./src/lib/utils/*/index.ts",
      "default": "./src/lib/utils/*/index.ts"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js"
      },
      "./styles/*": "./dist/styles/*",
      "./theme": {
        "types": "./dist/theme/index.d.ts",
        "import": "./dist/theme/index.js"
      },
      "./utils/*": {
        "types": "./dist/utils/*/index.d.ts",
        "import": "./dist/utils/*/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "package": "svelte-package && publint",
    "prepack": "pnpm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "publint": "0.3.25",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  }
}
